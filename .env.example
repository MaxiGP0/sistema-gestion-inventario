# Conexión a MongoDB (local o Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/sistema-gestion-inventario

# Secreto para firmar la cookie de sesión (mínimo 16 caracteres, aleatorio).
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Identificador del build que versiona las cachés del service worker.
# Si se omite, next.config.ts usa GITHUB_SHA/VERCEL_GIT_COMMIT_SHA o un id local.
NEXT_PUBLIC_BUILD_ID=

# Vigencia del caché de sesión actual en escrituras, en segundos (30-60).
# Un valor menor aplica bajas/cambios de rol más rápido; 45 es el default.
AUTH_SESSION_CACHE_TTL_SECONDS=45

# Confiar en x-forwarded-for / x-real-ip para resolver la IP del cliente.
# Default false: sólo activarlo detrás de un proxy propio que reescriba esas
# cabeceras; si no, cualquier cliente podría evadir el rate limit por IP.
TRUST_PROXY_HEADERS=false

# Nivel de logging estructurado: info | warn | error | silent.
LOG_LEVEL=info

# --- Catálogo offline ---
# Topes del snapshot local. El full sync se pagina y guarda hasta estos valores.
OFFLINE_CATALOG_MAX_PRODUCTS=5000
OFFLINE_CATALOG_MAX_CLIENTS=2000

# --- Web Push (VAPID, opcional) ---
# Sin estas tres variables la app funciona y el envío de push queda apagado.
# Generar un par nuevo con: npx web-push generate-vapid-keys
# La clave pública se expone al navegador; la privada nunca sale del servidor.
# VAPID_SUBJECT debe ser un mailto: o una URL https:.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Observabilidad (Sentry, opcional) ---
# Sin DSN la app funciona igual: Sentry queda deshabilitado y las métricas son no-op.
# El DSN no es un secreto; se expone al navegador a través de NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Traces: 0 = apagado, 0.1 = 10 %, 1 = 100 %. Los errores NO usan este valor.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Build/source maps y provisioning de alertas (no se usan en runtime).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Solo para Sentry self-hosted.
SENTRY_URL=
# Entorno que evalúan las alertas (default: SENTRY_ENVIRONMENT/VERCEL_ENV).
SENTRY_ALERT_ENVIRONMENT=
# Destino de las alertas: user:<id> o team:<id>. Si se omite, se usa el dueño del token.
SENTRY_ALERT_TARGET=
# Acción Slack opcional (ambas variables son necesarias).
SENTRY_SLACK_INTEGRATION_ID=
SENTRY_SLACK_CHANNEL=

# Contraseña del usuario admin creado por `npm run seed` (opcional).
# Si se omite, el seed usa "demo2026".
SEED_ADMIN_PASSWORD=demo2026

# Usuarios adicionales opcionales del seed, formato Nombre[rol]:contraseña.
# Roles válidos: vendedor | controlador. Separar con coma o salto de línea.
# Nota: el seed ya incluye usuarios de demo listos para cada rol (admin, vendedor, controlador y facturista).
SEED_USERS=
